---
// The closing band every page ends on. `lead` is the plain part of the
// headline, `em` the emphasised end of it.
import { APP_STORE_URL } from '../consts';

const {
  lead = 'Launch a membership this afternoon — and',
  em = 'let it bill itself.',
  text = 'Install free, create one plan, and watch your first members land in the dashboard.',
} = Astro.props;
---
<section class="sec" style="padding-top:0">
  <div class="wrap">
    <div class="cta rv">
      <h2>{lead} <em>{em}</em></h2>
      <p>{text}</p>
      <div class="hero-cta" style="justify-content:center">
        <a href={APP_STORE_URL} class="btn btn-accent btn-lg">Install free <svg viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
        <a href="/support" class="btn btn-ghost btn-lg">Talk to us</a>
      </div>
    </div>
  </div>
</section>
