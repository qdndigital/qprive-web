---
import { SUPPORT_EMAIL, APP_STORE_URL, FEATURES_NAV } from '../consts';
import Logo from './Logo.astro';
const year = 2026;
---
<footer class="site">
  <div class="wrap">
    <div class="foot">
      <div>
        <Logo />
        <p class="fd">Memberships and subscriptions for Shopify. Sell plans with member pricing, attach perks, and let QPrive bill every cycle for you.</p>
      </div>
      <div>
        <h2>Product</h2>
        {FEATURES_NAV.map(([href, label]) => <a href={href}>{label}</a>)}
        <a href="/pricing">Pricing</a>
      </div>
      <div>
        <h2>Company</h2>
        <a href="/support">Support</a>
        <a href="/privacy">Privacy Policy</a>
        <a href="/terms">Terms of Service</a>
        <a href={`mailto:${SUPPORT_EMAIL}`}>Contact</a>
      </div>
      <div>
        <h2>Get started</h2>
        <a href={APP_STORE_URL}>Install from the App Store</a>
        <a href="/faqs">FAQs</a>
        <a href="/support">Get setup help</a>
      </div>
    </div>
    <div class="fbar">
      <span>© {year} QPrive. All rights reserved.</span>
      <span>Built for Shopify merchants.</span>
    </div>
  </div>
</footer>
