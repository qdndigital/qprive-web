---
// Product-page purchase options as the theme block renders them, with the
// member perks underneath. Illustrative product and prices.
---
<div class="po" aria-label="Purchase options on a product page (illustrative)">
  <div class="po-prod">
    <span class="po-img" aria-hidden="true">
      <svg viewBox="0 0 64 64"><rect x="18" y="20" width="28" height="34" rx="6"/><path d="M24 20v-5h16v5"/><path d="M32 30c-3 4-3 8 0 11 3-3 3-7 0-11z"/></svg>
    </span>
    <div><b>Signature Candle</b><span>$40.00</span></div>
  </div>
  <div class="po-opts">
    <div class="po-opt"><span class="po-r"></span><span class="po-t">One-time purchase</span><span class="po-p">$40.00</span></div>
    <div class="po-opt on">
      <span class="po-r"></span>
      <span class="po-t">Subscribe &amp; save <em>15%</em><small>Delivery every 1 month</small></span>
      <span class="po-p"><s>$40.00</s>$34.00</span>
    </div>
    <div class="po-freq"><span>Every 1 month</span><span class="on">Every 3 months · 20%</span></div>
  </div>
  <div class="po-perks">
    <span class="po-k">Member perks</span>
    <span class="perk"><i>%</i> 10% off every order</span>
    <span class="perk"><i>⇢</i> Free shipping</span>
    <span class="perk"><i>✦</i> Welcome gift</span>
  </div>
  <span class="btn btn-accent w-full po-btn">Join &amp; add to cart</span>
</div>
